# Public origin used for generated canonical metadata and sitemap, update before deployment.
VITE_PUBLIC_ORIGIN=https://courseaccess.example
# Optional Cloudflare Worker for future authenticated account capabilities.
# VITE_API_BASE_URL=https://your-worker.your-subdomain.workers.dev

# Paddle preflight only. Keep actual API keys in secrets, never commit them.
PADDLE_LIVE_API_KEY=
PADDLE_LIVE_CLIENT_TOKEN=
PADDLE_SANDBOX_API_KEY=
PADDLE_SANDBOX_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=

# Local preview only: client-side token (never a server API key).
VITE_PADDLE_LIVE_CLIENT_TOKEN=

# Private loopback sandbox checkout only; never mix with live prices.
VITE_PADDLE_SANDBOX_CLIENT_TOKEN=
VITE_PADDLE_SANDBOX_PRO_PRICE_ID=
VITE_PADDLE_SANDBOX_INSTITUTION_PRICE_ID=
# Worker sandbox webhook configuration belongs in staging secrets/vars, not VITE_ env.
