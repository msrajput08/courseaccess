{
  "name": "courseaccess",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "predev": "node scripts/vendor-ocr.mjs",
    "prebuild": "node scripts/vendor-ocr.mjs",
    "test:auth:worker": "playwright test --config=playwright.auth.config.ts",
    "test:auth:live": "playwright test --config=playwright.live.auth.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test:corpus": "playwright test --config=playwright.corpus.config.ts",
    "test:external-corpus": "playwright test --config=playwright.external.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "katex": "^0.19.1",
    "jszip": "^3.10.1",
    "motion": "^12.23.12",
    "pdfjs-dist": "~5.4.624",
    "pdfkit": "0.20.2",
    "pdf-lib": "^1.17.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "tesseract.js": "^7.0.0",
    "@fontsource/noto-sans": "^5.2.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@fontsource/dm-sans": "^5.2.7",
    "@fontsource/dm-serif-display": "^5.2.7",
    "tesseract.js-core": "^7.0.0",
    "@simplewebauthn/server": "13.3.3",
    "@simplewebauthn/browser": "13.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/katex": "^0.16.8",
    "@types/pdfkit": "^0.17.4",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.56.1",
    "@axe-core/playwright": "^4.14.0",
    "wrangler": "^4.36.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/hin": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@tesseract.js-data/deu": "1.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
